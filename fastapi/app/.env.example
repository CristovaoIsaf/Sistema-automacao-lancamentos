# Copia para .env (nesta mesma pasta) e preenche os valores reais.
# Nunca commitar o .env real — já está no .gitignore.

# Google Gemini — usado pelo DocumentAnalyzer para sugerir lançamentos
GEMINI_API_KEY=

# Caminho do executável do Tesseract OCR (detectado automaticamente em
# Windows/Linux/macOS se deixares em branco — ver config/settings.py)
TESSERACT_CMD=

# AnythingLLM (RAG, opcional — sem isto o sistema cai sempre no fallback
# por regras determinísticas, ver README "Camada de IA"). Se o AnythingLLM
# correr só localmente, BASE_URL tem de ser um túnel público (ex.: ngrok)
# para o Railway (onde este serviço fica hospedado) conseguir alcançá-lo.
ANYTHINGLLM_BASE_URL=http://localhost:3001
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_WORKSPACE_NORMAS=workspace-normativo
ANYTHINGLLM_WORKSPACE_EXEMPLOS=regras-do-negocio
