# Copia para .env e ajusta. Nunca commitar o .env real — já está no
# .gitignore. Isto só afeta `npm run dev` local — a Vercel usa as suas
# próprias variáveis de ambiente (configuradas no dashboard do projeto),
# não este ficheiro.

# URL do backend (Spring Boot). Se ficar por definir, cai em
# http://localhost:8080 (ver src/app/api/client.ts).
VITE_API_BASE_URL=http://localhost:8080
